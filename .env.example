# Optional. The API uses a local H2 database and skips email when these are unset.
# Copy to .env and export the variables before starting the app. Do not commit .env.

# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cusr
# SPRING_DATASOURCE_USERNAME=cusr
# SPRING_DATASOURCE_PASSWORD=

# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# CUSR_MAIL_FROM=noreply@example.com
